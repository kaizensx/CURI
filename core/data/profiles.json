  "gh:ahujasid/mcp-for-blender": {
   "kind": "mcp",
   "agent_use": "Dá ao agente ferramentas para criar e alterar cenas no Blender em tempo real.",
   "related": [
    "web:projects.blender.org/blender/blender"
   ],
   "install": [
    {
     "method": "mcp",
     "transport": "stdio",
     "command": "uvx",
     "args": [
      "mcp-for-blender==2.2.6"
     ],
     "requires": [
      "uv"
     ],
     "label": "uvx mcp-for-blender",
     "setup": [
      "No Blender: Edit › Preferences › Add-ons › Install from Disk… e escolha o addon.py do repositório.",
      "Ative o addon e, no painel lateral (N) › BlenderMCP, carregue em Connect."
     ]
    }
   ]
  },
