  "web:projects.blender.org/blender/blender": {
   "kind": "app",
   "agent_use": "The agent drives Blender (scenes, objects, materials, rendering) through the Blender MCP server.",
   "related": [
    "gh:ahujasid/mcp-for-blender"
   ],
   "install": [
    {
     "method": "package",
     "manager": "cask",
     "name": "blender",
     "os": [
      "macos"
     ]
    },
    {
     "method": "package",
     "manager": "winget",
     "name": "BlenderFoundation.Blender",
     "os": [
      "windows"
     ]
    },
    {
     "method": "package",
     "manager": "flatpak",
     "name": "org.blender.Blender",
     "os": [
      "linux"
     ]
    },
    {
     "method": "download",
     "url": "https://www.blender.org/download/",
     "label": "Download from the official site"
    }
   ]
  },
  "gh:ahujasid/mcp-for-blender": {
   "kind": "mcp",
   "agent_use": "Gives the agent tools to create and change Blender scenes live.",
   "related": [
    "web:projects.blender.org/blender/blender"
   ],
   "install": [
    {
     "method": "mcp",
     "transport": "stdio",
     "command": "uvx",
     "args": [
      "mcp-for-blender==2.2.6"
     ],
     "requires": [
      "uv"
     ],
     "label": "uvx mcp-for-blender",
     "setup": [
      "In Blender: Edit › Preferences › Add-ons › Install from Disk… and pick addon.py from the repository.",
      "Enable the add-on and, in the side panel (N) › BlenderMCP, click Connect."
     ]
    }
   ]
  },
